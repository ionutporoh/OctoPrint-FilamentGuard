<h3>{{ _('Filament Guard') }}</h3>

<form class="form-horizontal">
    <h4>{{ _('Sensor') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('GPIO pin (BCM)') }}</label>
        <div class="controls">
            <input type="number" min="-1" max="27" class="input-mini" data-bind="value: settings.gpio_pin">
            <span class="help-inline">{{ _('-1 disables the sensor') }}</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Count edge') }}</label>
        <div class="controls">
            <select class="input-medium" data-bind="value: settings.edge">
                <option value="rising">{{ _('Rising') }}</option>
                <option value="falling">{{ _('Falling') }}</option>
                <option value="both">{{ _('Both') }}</option>
            </select>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Bias') }}</label>
        <div class="controls">
            <select class="input-medium" data-bind="value: settings.bias">
                <option value="pull_up">{{ _('Pull-up') }}</option>
                <option value="pull_down">{{ _('Pull-down') }}</option>
                <option value="none">{{ _('None (external)') }}</option>
            </select>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Debounce (ms)') }}</label>
        <div class="controls">
            <input type="number" min="0" max="50" class="input-mini" data-bind="value: settings.debounce_ms">
        </div>
    </div>

    <h4>{{ _('Detection') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('Mode') }}</label>
        <div class="controls">
            <select class="input-xlarge" data-bind="value: settings.mode">
                <option value="timeout">{{ _('No-motion timeout (full jam / runout)') }}</option>
                <option value="distance">{{ _('Distance comparison (adds partial clog detection)') }}</option>
            </select>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Trigger after (mm without pulse)') }}</label>
        <div class="controls">
            <input type="number" min="1" step="0.5" class="input-mini" data-bind="value: settings.timeout_mm">
            <span class="help-inline">{{ _('commanded extrusion with zero sensor pulses') }}</span>
        </div>
    </div>
    <div class="control-group" data-bind="visible: settings.mode() == 'distance'">
        <label class="control-label">{{ _('Comparison window (mm)') }}</label>
        <div class="controls">
            <input type="number" min="5" step="1" class="input-mini" data-bind="value: settings.window_mm">
        </div>
    </div>
    <div class="control-group" data-bind="visible: settings.mode() == 'distance'">
        <label class="control-label">{{ _('Minimum measured/commanded ratio') }}</label>
        <div class="controls">
            <input type="number" min="0.1" max="1" step="0.05" class="input-mini" data-bind="value: settings.ratio_threshold">
            <span class="help-inline">{{ _('below this for N consecutive windows → clog') }}</span>
            <input type="number" min="1" max="10" class="input-mini" data-bind="value: settings.consecutive_windows">
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Grace distance after start/resume (mm)') }}</label>
        <div class="controls">
            <input type="number" min="0" step="1" class="input-mini" data-bind="value: settings.grace_mm">
        </div>
    </div>

    <h4>{{ _('Actions on trigger') }}</h4>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.action_pause"> {{ _('Pause the print') }}
            </label>
            <input type="text" class="input-medium" placeholder="{{ _('blank = OctoPrint pause, or e.g. M600') }}"
                   data-bind="value: settings.pause_command, enable: settings.action_pause">
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Extra G-code before pausing') }}</label>
        <div class="controls">
            <textarea rows="3" class="input-xlarge" placeholder="; e.g. park head, beep"
                      data-bind="value: settings.action_gcode"></textarea>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.popup"> {{ _('Show popup notification') }}
            </label>
        </div>
    </div>

    <h4>{{ _('Calibration') }}</h4>
    <p class="muted">
        {{ _('Extrudes a fixed length of filament and counts sensor pulses to learn mm-per-pulse. Requires a hot nozzle and idle printer.') }}
    </p>
    <div class="control-group">
        <label class="control-label">{{ _('mm per pulse') }}</label>
        <div class="controls">
            <input type="number" min="0" step="0.0001" class="input-small" data-bind="value: settings.mm_per_pulse">
            <button class="btn" data-bind="click: calibrate, enable: !calibrating()">
                <i class="fas fa-ruler"></i> {{ _('Calibrate now') }}
            </button>
            <span class="help-inline" data-bind="text: calibrationStatus"></span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Calibration length / feedrate') }}</label>
        <div class="controls">
            <input type="number" min="20" step="10" class="input-mini" data-bind="value: settings.calibration_length"> mm @
            <input type="number" min="30" step="10" class="input-mini" data-bind="value: settings.calibration_feedrate"> mm/min
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">{{ _('Minimum extrude temp (°C)') }}</label>
        <div class="controls">
            <input type="number" min="150" max="300" class="input-mini" data-bind="value: settings.min_extrude_temp">
        </div>
    </div>
</form>
